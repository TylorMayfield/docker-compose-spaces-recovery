# Keep the real file outside this repository and mode 0600.
APP_DIR=/srv/your-app
BUCKET=your-private-bucket
REGION=nyc3
PREFIX=compose-recovery
AWS_ACCESS_KEY_ID=replace_with_limited_spaces_key
AWS_SECRET_ACCESS_KEY=replace_with_limited_spaces_secret
AGE_RECIPIENT=age1replace_with_your_public_recipient

# List only non-database named volumes. A PostgreSQL volume needs pg_dump.
VOLUME_NAMES=your_app_data
POSTGRES_SERVICE=
POSTGRES_DATABASE=
POSTGRES_USER=

# Restore settings. Use a different server and keep this value exactly test.
RESTORE_ENV=test
TIMESTAMP=YYYY-MM-DDTHH-MM-SSZ
RESTORE_DIR=/srv/compose-recovery-test
AGE_IDENTITY=/secure-path/recovery-key.txt
RESTORE_VOLUME_PREFIX=recovered

# Set these only when the recovery set contains postgres.dump. Start a fresh
# test-only PostgreSQL container and database before the apply command. Keep
# the password in this root-only restore file; never put it in the repository.
RESTORE_POSTGRES_CONTAINER=
RESTORE_POSTGRES_DATABASE=
RESTORE_POSTGRES_USER=
RESTORE_POSTGRES_PASSWORD=
